alias gs='git status'
alias ga='git add'
alias gp='git push'
alias gpo='git push origin'
alias gtd='git tag --delete'
alias gtdr='git tag --delete origin'
alias gr='git branch -r'
alias gplo='git pull origin'
alias gb='git branch '
alias gc='git commit'
alias gd='git diff'
alias gco='git checkout '
alias gl='git log'
alias gr='git remote'
alias grs='git remote show'
alias glo='git log --pretty="oneline"'
alias glol='git log --graph --oneline --decorate'

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias la='ls -a'

alias c='clear'

# Alias rm to move to trash using trash-cli
alias rm='echo "this is not the command you are looking for"; false'
alias tr='trash-put'
# Optional: Add aliases for other trash-cli commands for convenience
alias trl='trash-list'     # List trash contents
alias trr='trash-restore'  # Restore files from trash
alias tre='trash-empty'    # Empty the trash
