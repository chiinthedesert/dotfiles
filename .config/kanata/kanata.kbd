(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  danger-enable-cmd yes
)

(defsrc
  esc
  grv      1     2     3     4     5        6     7     8     9     0     -     =     bspc
  tab      q     w     e     r     t        y     u     i     o     p     [     ]     \
  caps     a     s     d     f     g        h     j     k     l     ;     '     ret
  lsft     z     x     c     v     b        n     m     ,     .     /     rsft
  lctl     lmet  lalt        spc          ralt  rmet  rctl
)

(defalias
  escctrl     (tap-hold-press 200 200 esc lctl)
  minusctrl   (tap-hold-press 200 200 - rctl)
  retalt      (tap-hold-press 200 200 ret lalt)
  bspcalt     (tap-hold-press 200 200 bspc ralt)
  ctlsft      (multi lctl lsft)
  sft         (one-shot 500 (layer-while-held sft))
  sftd        (one-shot 500 (layer-while-held sftd))
  spc         (tap-hold-press 200 200 spc (layer-while-held symbols))
  z           (tap-hold-press 200 200 z (layer-while-held numpad))
  /           (tap-hold-press 200 200 / (layer-while-held numpad))

  layout-toggle (switch
    ((base-layer qwerty))   (layer-switch dvorak) break
    ((base-layer dvorak)) (layer-switch qwerty)   break
  )
)

(defchordsv2
  (lmet spc) @layout-toggle 150 first-release ()
)

(deflayer dvorak
  XX
  caps     1     2     3     4     5        6     7     8     9     @sftd XX    XX    XX
  tab      '     ,     .     p     y        f     g     c     r     l     bspc  XX    XX
  @escctrl a     o     e     u     i        d     h     t     n     s     @minusctrl ret
  @sftd    @/    q     j     k     x        b     m     w     v     z     @sftd
  @ctlsft  lmet  @retalt     @spc         lalt  rmet  @ctlsft
)

(deflayer sftd
  _
  _        S-1   S-2   S-3   S-4   S-5      S-6   S-7   S-8   S-9   _     XX    XX    XX
  S-tab    S-'   S-,   S-.   S-p   S-y      S-f   S-g   S-c   S-r   S-l   _     XX    XX
  _        S-a   S-o   S-e   S-u   S-i      S-d   S-h   S-t   S-n   S-s   S--   _
  _        S-/   S-q   S-j   S-k   S-x      S-b   S-m   S-w   S-v   S-/   _
  _        _     _           S-spc        _     _     _
)

(deflayer qwerty
  XX
  caps     1     2     3     4     5        6     7     8     9     @sft  XX    XX    XX
  tab      q     w     e     r     t        y     u     i     o     p     bspc  XX    XX
  @escctrl a     s     d     f     g        h     j     k     l     '     @minusctrl ret
  @sft     @z    x     c     v     b        n     m     ,     .     /     @sft
  @ctlsft  lmet  @retalt     @spc         lalt  rmet  @ctlsft
)

(deflayer sft
  _
  _        S-1   S-2   S-3   S-4   S-5      S-6   S-7   S-8   S-9   _     XX    XX    XX
  S-tab    S-q   S-w   S-e   S-r   S-t      S-y   S-u   S-i   S-o   S-p   _     XX    XX
  _        S-a   S-s   S-d   S-f   S-g      S-h   S-j   S-k   S-l   S-'   S--   _
  _        S-z   S-x   S-c   S-v   S-b      S-n   S-m   S-,   S-.   S-/   _
  _        _     _           S-spc        _     _     _
)

(deflayer symbols
  _
  _        _     _     _     _     _        _     _     _     _     ret   _     _     _
  _        grv   S-,   S-.   -     S-\      S-6   S-[   S-]   S-4   (macro - S-.) _ _ _
  spc      S-1   S-8   /     =     S-7      S-3   S-9   S-0   ;     S-'   _     _
  _        S-grv S-=   [     ]     S-5      S-2   S-;   S-/   S--   \     _
  _        _     _           _            _     _     _
)

(deflayer numpad
  _
  _        _     _     _     _     _        _     _     _     _     ret   _     _     _
  _        _     _     _     _     _        _     1     2     3     _     _     _     _
  _        _     _     _     _     _        _     4     5     6     0     _     _
  _        z     _     _     _     _        _     7     8     9     _     _
  _        _     _           _            _     _     _
)
