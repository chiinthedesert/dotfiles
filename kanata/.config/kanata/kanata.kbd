(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  danger-enable-cmd yes
)

(defsrc
  esc
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    q      w      e      r      t      y      u      i      o      p      [      ]      \
  caps   a      s      d      f      g      h      j      k      l      ;      '      ret
  lsft   z      x      c      v      b      n      m      ,      .      /      rsft 
  lctl   lmet   lalt          spc           ralt   rmet   rctl
)

(defvar
  left_hand (q w e r t a s d f g z x c v b)
  right_hand (y u i o p h j k l ; n m , . /)
)

(defalias
  a      (tap-hold-release-keys 175 150 a lmet $left_hand)
  s      (tap-hold-release-keys 175 150 s lalt $left_hand)
  d      (tap-hold-release-keys 175 150 d lsft $left_hand)
  f      (tap-hold-release-keys 175 150 f lctl $left_hand)

  j      (tap-hold-release-keys 175 150 j rctl $right_hand)
  k      (tap-hold-release-keys 175 150 k rsft $right_hand)
  l      (tap-hold-release-keys 175 150 l ralt $right_hand)
  ;      (tap-hold-release-keys 175 150 ; rmet $right_hand)

  lalt   (tap-hold-release 175 150 tab lalt)
  ralt   (tap-hold-release 175 150 bspc lalt)

  cw     (caps-word 2000)
  esc    (tap-dance 200 ((caps-word 2000) caps))
  spc    (tap-hold-release 175 150 spc (layer-while-held nav))
  syms   (tap-hold-release 175 150 (one-shot 1000 (layer-while-held symbols)) (layer-while-held symbols))
)
(defchordsv2
  (i o) ret 75 first-release ()
  (w e) esc 75 first-release ()
)


(deflayer qwerty
  @esc
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    q      w      e      r      t      y      u      i      o      p      [      ]      \
  @syms  @a     @s     @d     @f     g      h      @j     @k     @l     @;     @syms  ret
  lsft   z      x      c      v      b      n      m      ,      .      '      rsft 
  lctl   lmet   @lalt         @spc          @ralt   rmet   rctl
)

(deflayer symbols
  _
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      '      S-,    S-.    S-'    S-6    S-4    S-5    S-[    S-]    S-/    _      _      _
  _      S-1    -      S-=    =      S-3    S-\    S-;    S-9    S-0    ;      _      _
  _      S-`    /      S-8    \      `      S--    S-7    [      ]      S-2    _
  _      _      _             _             _      _      _
)

(deflayer nav
  _
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      S-8    7      8      9      S-=    home   pgdn   pgup   end    _      _      _      _
  _      0      4      5      6      =      left   down   up     right  _      _      _
  _      /      1      2      3      -      del    bspc   _      _      _      _
  _      _      _             _             _      _      _
)
