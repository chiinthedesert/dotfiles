(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  danger-enable-cmd yes
)

(defsrc
  esc
  grv      1     2     3     4     5        6     7     8     9     0     -     =     bspc
  tab      q     w     e     r     t        y     u     i     o     p     [     ]     \
  caps     a     s     d     f     g        h     j     k     l     ;     '     ret
  lsft     z     x     c     v     b        n     m     ,     .     /     rsft
  lctl     lmet  lalt        spc          ralt  rmet  rctl
)

(defalias
  escctrl     (tap-hold-release 150 150 esc lctl)
  minusctrl   (tap-hold-release 150 150 - rctl)
  retalt      (tap-hold-release 150 150 ret lalt)
  bspcalt     (tap-hold-release 150 150 bspc lalt)
  S-retalt    (tap-hold-release 150 150 S-ret lalt)
  S-bspcalt   (tap-hold-release 150 150 S-bspc lalt)
  ctlsft      (multi lctl lsft)
  sft         (one-shot 500 (layer-while-held sft))
  a           (tap-hold-release 150 150 a (layer-while-held sft))
  s           (tap-hold-release 150 150 s (layer-while-held sft))
  spc         (tap-hold-release 150 150 spc (layer-while-held symbols))
  num         (tap-hold-release 150 150 lsft (layer-while-held numpad))
)

;;(deflayer qwerty
;;  caps
;;  XX       S-2   [     S-[   S-9   S-6      XX    S-4   S-0   S-]   ]     `    XX    XX
;;  tab      q     w     e     r     t        y     u     i     o     p     XX   XX    XX
;;  @escctrl @a    s     d     f     g        h     j     k     l     @'    @minusctrl ret
;;  @num     z     x     c     v     b        n     m     ,     .     /     rsft
;;  @ctlsft  lmet  @retalt     @spc      @bspcalt    rmet  @ctlsft
;;)

(deflayer dvorak
  caps
  XX       S-2   [     S-[   S-9   S-6      XX    S-4   S-0   S-]   ]     `     XX    XX
  tab      '     ,     .     p     y        f     g     c     r     l     XX  XX    XX
  @escctrl @a    o     e     u     i        d     h     t     n     @s    @minusctrl ret
  @num     /     q     j     k     x        b     m     w     v     z     rsft
  @ctlsft  lmet  @retalt     @spc        @bspcalt  rmet  @ctlsft
)

(deflayer sft
  _
  _        1     2     3     4     5        XX    6     7     8     9     0     XX    XX
  S-tab    S-'   S-,   S-.   S-p   S-y      S-f   S-g   S-c   S-r   S-l   _     XX    S-ret
  _        S-a   S-o   S-e   S-u   S-i      S-d   S-h   S-t   S-n   S-s   S--   _
  lsft     S-/   S-q   S-j   S-k   S-x      S-b   S-m   S-w   S-v   S-z   _
  _        _     @S-retalt   S-spc        _     _     _
)





(deflayer symbols
  _
  _        _     _     _     _     _        _     _     _     _     _     _     _     _
  _        _     S-2   S-3   S-\   _        _     ;     -     S--   _     _     _     _
  _      S-`   S-8   S-,   S-.   _        _     =     /     S-1   S-'   _     _
  _        _     S-5   S-/   S-7   _        _     S-;   S-=   \     _     _
  _        _     _           _            _     _     _
)

(deflayer numpad
  _
  _        _     _     _     _     _        _     _     _     _     _     _     _     _
  _        _     _     _     _     _        _     7     8     9     _     _     _     _
  _        _     _     _     _     _        _     4     5     6     0     _     _
  _        _     _     _     _     _        _     1     2     3     _     _
  _        _     _           _            _     _     _
)
