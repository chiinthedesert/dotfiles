(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  danger-enable-cmd yes
)

;; Timings
(defvar
  tapping-term 300
  quick-tap-ms 200
  require-prior-idle 250

  ;; Same-hand trigger keys
  left-side-keys (q w e r t z x c v b)
  right-side-keys (y u i o p n m , . /)

  ;; Home-row trigger keys
  home-row-left-keys (a s d f g)
  home-row-right-keys (h j k l scln apos)
)

;; Home row mod templates
(deftemplate lhrm (tappingterm tap-key hold-key)
  (tap-hold-release-tap-keys-release
    $quick-tap-ms
    $tappingterm
    (multi $tap-key @tap)
    $hold-key
    $left-side-keys
    $home-row-left-keys
  )
)

(deftemplate rhrm (tappingterm tap-key hold-key)
  (tap-hold-release-tap-keys-release
    $quick-tap-ms
    $tappingterm
    (multi $tap-key @tap)
    $hold-key
    $right-side-keys
    $home-row-right-keys
  )
)

;; Normal typing keys
(deftemplate nomod (tap-key)
  (multi $tap-key @tap)
)

(defalias

  ;; Prior-idle workaround
  tap (multi
    (layer-switch nomods)
    (on-idle $require-prior-idle tap-virtualkey to-base)
  )

  ;; Left hand
  ;; Pinky  - Super
  ;; Ring   - Alt
  ;; Middle - Shift
  ;; Index  - Ctrl
  a (t! lhrm $tapping-term a lmet)
  s (t! lhrm $tapping-term s lalt)
  d (t! lhrm $tapping-term d lsft)
  f (t! lhrm $tapping-term f lctl)

  ;; Right hand
  ;; Index  - Ctrl
  ;; Middle - Shift
  ;; Ring   - Alt
  ;; Pinky  - Super
  j (t! rhrm $tapping-term j rctl)
  k (t! rhrm $tapping-term k rsft)
  l (t! rhrm $tapping-term l ralt)
  semi (t! rhrm $tapping-term scln rmet)

  ;; Other letters
  q (t! nomod q)
  w (t! nomod w)
  e (t! nomod e)
  r (t! nomod r)
  t (t! nomod t)
  g (t! nomod g)

  h (t! nomod h)
  y (t! nomod y)
  u (t! nomod u)
  i (t! nomod i)
  o (t! nomod o)
  p (t! nomod p)

  z (t! nomod z)
  x (t! nomod x)
  c (t! nomod c)
  v (t! nomod v)
  b (t! nomod b)
  n (t! nomod n)
  m (t! nomod m)

  ;; Punctuation and space
  apostrophe (t! nomod apos)
  comma (t! nomod ,)
  dot (t! nomod .)
  slash (t! nomod /)
  space-key (t! nomod spc)
)

;; Return to the base layer
(defvirtualkeys
  to-base (layer-switch qwerty)
)

;; Physical keyboard
(defsrc
  esc
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    q      w      e      r      t      y      u      i      o      p      [      ]      \
  caps   a      s      d      f      g      h      j      k      l      ;      '      ret
  lsft   z      x      c      v      b      n      m      ,      .      /      rsft
  lctl   lmet   lalt          spc           ralt   prtsc   rctl
)

;; Print Screen chord
(defchordsv2
  (i o) prtsc 75 first-release ()
)

;; Main layer
(deflayer qwerty
  caps
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    @q     @w     @e     @r     @t     @y     @u     @i     @o     @p     [      ]      \
  esc    @a     @s     @d     @f     @g     @h     @j     @k     @l     @semi  @apostrophe ret
  lsft   @z     @x     @c     @v     @b     @n     @m     @comma @dot   @slash rsft
  lctl   lmet   lalt          @space-key   ralt   rmet   rctl
)

;; Temporary layer without home row mods
;; Shift remains functional for fast capitalization
(deflayer nomods
  caps
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    q      w      e      r      t      y      u      i      o      p      [      ]      \
  esc    a      s      @d     f      g      h      j      @k     l      scln   apos   ret
  lsft   z      x      c      v      b      n      m      ,      .      /      rsft
  lctl   lmet   lalt          spc           ralt   rmet   rctl
)
