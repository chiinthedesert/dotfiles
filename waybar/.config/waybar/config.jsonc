{
  "layer": "top", // Waybar at top layer
  "position": "left", // Waybar position (top|bottom|left|right)
  "orientation": "vertical",
  // "margin": "4 0 4 2",
  // "spacing": 0, // Gaps between modules (4px)
  // "output": "HDMI-A-1",
  "modules-left": [
    "hyprland/workspaces",
    "custom/colorpicker",
    "wlr/taskbar"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "network",
    "pulseaudio",
    "backlight",
    "cpu",
    "memory",
    "temperature",
    "battery"
  ],



  // Modules configuration
  "hyprland/workspaces": {
    "format":"{icon}",
    "format-icons": {
      "urgent": "◆",
      "active": "◆",
      "default": "◆"
    },
    "persistent-workspaces": {
      "*": [1,2,3,4,5,6,7]
    }
  },
  "custom/colorpicker": {
    "format": "",
    "return-type": "json",
    "interval": "once",
    "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
    "on-click": "~/.config/waybar/scripts/colorpicker.sh",
    "signal": 1
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 24
  },


  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  },

  "tray": {
    "icon-size": 24
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "", // Open eye (Inhibit is active)
      "deactivated": "" // Closed eye (Inhibit is inactive)
    },
    "timeout": 180
  },
  "network": {
    "justify": "center",
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "wi\n{signalStrength}",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{essid} ({signalStrength}%)",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "⚠"
  },
  "cpu": {
    "justify": "center",
    "format": "cp\n{usage}"
  },


  "memory": {
    "justify": "center",
    "format": "me\n{}"
  },


  "temperature": {
    "justify": "center",
    // "thermal-zone": 2,
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    // "critical-threshold": 85,
    // "format-critical": "{temperatureC}°C {icon}",
    "format": "{temperatureC}\n°C"
  },


  "backlight": {
    "justify": "center",
    // "device": "acpi_video1",
    "format": "br\n{percent}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "tooltip-format": false
  },


  "battery": {
    "justify": "center",
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "ba\n{capacity}",
    "format-full": "ba\n{capacity}",
    "format-charging": "\n{capacity}",
    "format-plugged": "\n{capacity}",
    "format-alt": false,
  },





  "pulseaudio": {
    "justify": "center",
    // "scroll-step": 1, // %, can be a float
    "format": "vo\n{volume}",
    "format-bluetooth": "{volume}  {format_source}",
    "format-bluetooth-muted": "   {format_source}",
    "format-muted": "m",
    "format-source": "\n{volume} ",
    "format-source-muted": "",
    "on-click": "pavucontrol"
  },

}
